# ---------------------------------------------------------------
# docker compose settings (copy to `.env` next to docker-compose.yml)
# For running the backend without Docker, use backend/.env.example.
# ---------------------------------------------------------------

# Password for the database user the API connects as.
POSTGRES_PASSWORD=change-me

# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=replace-with-a-long-random-string

# Host port for the API + hub UI.
API_PORT=8000
CORS_ORIGINS=http://localhost:8000

# Speech-to-text: local | groq | openai
ASR_PROVIDER=local
# Set to false to skip baking the local Whisper model into the image.
PRELOAD_MODEL=true

# AI formatting / Command Mode / Transforms: none | anthropic | openai | groq
LLM_PROVIDER=none
ANTHROPIC_MODEL=claude-opus-5-5

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
