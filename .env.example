# ---------------------------------------------------------------
# docker compose settings (copy to `.env` next to docker-compose.yml)
# For running the backend without Docker, use backend/.env.example.
# ---------------------------------------------------------------

# Password for the database user the API connects as.
POSTGRES_PASSWORD=change-me

# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=replace-with-a-long-random-string

# Host port for the API + hub UI.
API_PORT=8000
CORS_ORIGINS=http://localhost:8000

# Groq runs speech-to-text and AI cleanup (free key at console.groq.com).
# Without a key Murmur falls back to local Whisper and rule-based cleanup.
GROQ_API_KEY=

# Speech-to-text: groq | local | openai
ASR_PROVIDER=groq
GROQ_ASR_MODEL=whisper-large-v3-turbo
# Bakes the local Whisper model into the image as the offline fallback.
PRELOAD_MODEL=true

# AI cleanup / Command Mode / Transforms: groq | anthropic | openai | none
LLM_PROVIDER=groq
GROQ_LLM_MODEL=qwen/qwen3.8-27b
ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
