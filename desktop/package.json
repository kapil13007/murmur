{
  "name": "prem-murmur-desktop",
  "productName": "Murmur",
  "version": "1.0.1",
  "private": true,
  "description": "Murmur desktop app: global push-to-talk dictation into any app",
  "author": "Prem",
  "main": "main/index.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "cross-env HUB_URL=http://localhost:5173 node scripts/start.js",
    "build:helper": "node helper/build.js",
    "icons": "node scripts/make-icons.js",
    "postinstall": "node helper/build.js",
    "dist": "npm run build:hub && npm run build:helper && electron-builder --win",
    "build:hub": "node scripts/build-hub.js"
  },
  "build": {
    "appId": "com.prem.murmur",
    "productName": "Murmur",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "assets/**",
      "package.json",
      "murmur.config.json"
    ],
    "extraResources": [
      {
        "from": "helper/bin/MurmurHelper.exe",
        "to": "MurmurHelper.exe"
      },
      {
        "from": "hub",
        "to": "hub"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Murmur-Setup.exe"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
