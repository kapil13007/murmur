# ---------------------------------------------------------------
# Murmur backend configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------

# --- Server ---
PORT=8000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# When true and ../frontend/dist exists, the API also serves the built hub UI.
SERVE_FRONTEND=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://whisper_flow_app:change-me@localhost:5432/whisper_flow
# Only used by `npm run db:setup` to create the role + database above.
DATABASE_ADMIN_URL=postgres://postgres:your-postgres-password@localhost:5432/postgres

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=30

# --- Speech-to-text (ASR) ---
# groq   = Groq whisper-large-v3-turbo (recommended: fast and far more accurate
#          with names; free tier at console.groq.com). Falls back to local
#          Whisper automatically if Groq can't be reached.
# local  = Whisper running on this machine via transformers.js (no API key,
#          model downloads once; fine for testing, weaker with names)
# openai = OpenAI transcription API
ASR_PROVIDER=local
LOCAL_WHISPER_MODEL=onnx-community/whisper-base
LOCAL_WHISPER_DTYPE=q8
# Load the local model when the server boots so the first dictation is fast.
ASR_PRELOAD=true
GROQ_ASR_MODEL=whisper-large-v3-turbo
OPENAI_ASR_MODEL=whisper-1

# --- AI formatting / Command Mode / Transforms (LLM) ---
# none      = built-in rule-based cleanup only (works offline)
# anthropic = Claude via the official Anthropic SDK
# openai    = OpenAI chat completions
# groq      = Groq chat completions (recommended with qwen/qwen3.8-27b: ~200 ms)
LLM_PROVIDER=none
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_LLM_MODEL=gpt-4.1-mini
GROQ_LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_MS=12000

# --- Provider API keys (only the ones you use) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Retention ---
# Audio recordings are kept this many days so transcripts can be retried.
AUDIO_RETENTION_DAYS=14
