# Dockerfile.backend
# The Murmur API (Express + PostgreSQL). The app and hub UI ship in the
# Windows installer, so this image serves only /api/v1.
FROM node:24-slim
ENV NODE_ENV=production

# Run as the unprivileged user that ships with the Node image
WORKDIR /app/backend
RUN chown node:node /app/backend
USER node

# Dependencies. The optional local-Whisper package (hundreds of MB) is skipped:
# the hosted API transcribes with each user's own Groq key.
COPY --chown=node:node backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev --omit=optional

COPY --chown=node:node backend .

EXPOSE 8000

# Applies pending migrations on boot, then serves the API
CMD ["node", "server.js"]
